# Project exclude paths
/interface/target/


#Ignore aws template files
docker-compose.yml
docker_script.sh

# local dev service logs
logs/

# Local secrets (Stripe keys, Firebase service account). Only the README and
# the example file are tracked; see secrets/README.md.
/secrets/*
!/secrets/README.md
!/secrets/local.env.example

# Service accounts used to live in src/main/resources, where they were copied
# into target/ and the jar. Keep any stray copy out of git.
service-account.json

# Private working notes, kept locally only.
/CLAUDE.md
/docs/WORKPLAN.md

# IntelliJ: personal and machine-specific (local paths, hosts, database
# metadata). Only the shared run configurations are tracked.
/.idea/*
!/.idea/runConfigurations/

# AI tool project config (created by an IDE plug-in); local only.
/.ai/
